{
  "appId": "com.lizzread.app",
  "appName": "LIZZREAD",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#F6F7F5"
  },
  "ios": {
    "contentInset": "always",
    "allowsInlineMediaPlayback": true,
    "backgroundColor": "#F6F7F5",
    "limitsNavigationsToAppBoundDomains": false
  },
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "allowNavigation": [
      "*"
    ]
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "icon.svg",
      "iconColor": "#0F8A4D"
    }
  }
}