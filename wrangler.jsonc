{
  "name": "lizzread",
  "compatibility_date": "2025-01-01",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist-pages",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
